{{- /*
  iCalendar feed for a single event, served at <event>/index.ics.

  Dates come from the shared event-datetimes partial, so this file and the
  Google Calendar link can never disagree.

  The VTIMEZONE block is spelled out rather than relying on the TZID alone:
  Apple Calendar and Google resolve a bare IANA name, but Outlook does not
  always, and a wrong offset in a downloaded file is invisible until someone
  misses a seminar. RFC 5545 wants CRLF, which is this repo's line ending
  anyway. Text values escape per RFC 5545 section 3.3.11.
*/ -}}
{{- $dt := partial "event-datetimes.html" . -}}
{{- $summary := replaceRE "([\\\\;,])" "\\$1" .Title -}}
{{- $location := replaceRE "([\\\\;,])" "\\$1" (.Params.event_location | default "") -}}
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Institute for Quantitative Social Science//Events//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
{{ if and $dt.ok (not $dt.allday) -}}
BEGIN:VTIMEZONE
TZID:America/New_York
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
{{ end -}}
{{ if $dt.ok -}}
BEGIN:VEVENT
UID:{{ .Permalink }}
DTSTAMP:{{ now.UTC.Format "20060102T150405Z" }}
SUMMARY:{{ $summary }}
{{ if $dt.allday -}}
DTSTART;VALUE=DATE:{{ $dt.start }}
DTEND;VALUE=DATE:{{ $dt.end }}
{{ else -}}
DTSTART;TZID={{ $dt.tz }}:{{ $dt.start }}
DTEND;TZID={{ $dt.tz }}:{{ $dt.end }}
{{ end -}}
{{ with $location -}}
LOCATION:{{ . }}
{{ end -}}
URL:{{ $.Permalink }}
END:VEVENT
{{ end -}}
END:VCALENDAR
